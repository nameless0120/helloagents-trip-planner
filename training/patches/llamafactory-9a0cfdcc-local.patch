+def get_batch_logps_from_shifted_logits(
+    logits: "torch.Tensor",
+    shifted_labels: "torch.Tensor",
+    label_pad_token_id: int = IGNORE_INDEX,
+) -> tuple["torch.Tensor", "torch.Tensor"]:
+    r"""Compute selected-token log probabilities from already shifted logits.
+
+    This is equivalent to ``get_batch_logps`` after the usual causal shift, but
+    it lets callers pass logits for only the response positions. Long-context
+    DPO prompts can be very large while labels are only non-masked on the
+    answer suffix, so avoiding prompt-position vocab logits saves substantial
+    memory without changing the DPO objective.
+    """
+    if logits.shape[:-1] != shifted_labels.shape:
+        raise ValueError("Logits (batchsize x seqlen) and shifted labels must have the same shape.")
+
+    labels = shifted_labels.clone()
+    loss_mask = labels != label_pad_token_id
+    labels[labels == label_pad_token_id] = 0  # dummy token
+
+    if os.getenv("LLAMAFACTORY_LOGPS_ORIGINAL", "0").lower() in {"1", "true", "yes"}:
+        per_token_logps = torch.gather(logits.log_softmax(-1), dim=2, index=labels.unsqueeze(2)).squeeze(2)
+        valid_length = loss_mask.sum(-1)
+        return (per_token_logps * loss_mask).sum(-1), valid_length
+
+    chunk_size = int(os.getenv("LLAMAFACTORY_LOGPS_CHUNK_SIZE", "1024"))
+    chunk_size = max(1, chunk_size)
+    use_checkpoint = os.getenv("LLAMAFACTORY_LOGPS_CHECKPOINT", "1").lower() not in {"0", "false", "no"}
+    upcast_logits = os.getenv("LLAMAFACTORY_LOGPS_UPCAST", "0").lower() in {"1", "true", "yes"}
+
+    def _gather_logps(chunk_logits: "torch.Tensor", chunk_labels: "torch.Tensor") -> "torch.Tensor":
+        if upcast_logits:
+            chunk_logits = chunk_logits.float()
+
+        selected_logits = torch.gather(chunk_logits, dim=2, index=chunk_labels.unsqueeze(2)).squeeze(2)
+        log_normalizers = torch.logsumexp(chunk_logits, dim=-1)
+        return selected_logits - log_normalizers
+
+    per_token_logps = []
+    for start_idx in range(0, labels.size(1), chunk_size):
+        end_idx = min(start_idx + chunk_size, labels.size(1))
+        chunk_logits = logits[:, start_idx:end_idx, :]
+        chunk_labels = labels[:, start_idx:end_idx]
+        if use_checkpoint and chunk_logits.requires_grad:
+            chunk_logps = torch.utils.checkpoint.checkpoint(
+                _gather_logps, chunk_logits, chunk_labels, use_reentrant=False
+            )
+        else:
+            chunk_logps = _gather_logps(chunk_logits, chunk_labels)
+
+        per_token_logps.append(chunk_logps.float())
+
+    per_token_logps = torch.cat(per_token_logps, dim=1)
+    valid_length = loss_mask.sum(-1)
+    logps = (per_token_logps * loss_mask).sum(-1)
+    return logps, valid_length
+
+
